# TMDb API key — https://www.themoviedb.org/settings/api (free, "API Read Access" not needed,
# the v3 key is enough). Without it the site still builds, but there are no age
# ratings, no audience scores and cross-language title matching is weaker.
TMDB_API_KEY=

# Public key embedded in the Cineplexx web bundle. Only set this if their site
# starts rejecting requests; the build has a working default.
CINEPLEXX_CLIENT_KEY=
