# TMDb API key — https://www.themoviedb.org/settings/api (free).
# Use the "API Key (v3 auth)" — the 32-character hex string. NOT the
# "API Read Access Token" (the long JWT starting with eyJ), which is v4 auth
# and is rejected by the endpoints this build calls.
# Without a key the site still builds, but there are no age ratings, no
# audience scores and cross-language title matching is weaker.
TMDB_API_KEY=

# Public key embedded in the Cineplexx web bundle. Only set this if their site
# starts rejecting requests; the build has a working default.
CINEPLEXX_CLIENT_KEY=
